<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pesoadois"
    android:versionCode="2"
    android:versionName="1.1.0">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_peso"
        android:label="Peso a dois"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <!-- A tela não é recriada em rotação. Troca de tema (uiMode) NÃO está nesta lista,
             para que o modo claro/escuro recrie a tela com a paleta certa. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:exported="true"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
